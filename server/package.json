{
  "name": "workflows-poc-server",
  "version": "0.1.0",
  "private": true,
  "description": "POC: workflow builder + durable runner (DBOS) + playground chatbot API",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "nest build && node --env-file-if-exists=.env dist/main.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "axios": "^1.20.0",
    "gtwy-sdk": "^0.5.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viasocket-apps": "^0.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "~6.0.2"
  }
}
