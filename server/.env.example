# API port (the web app runs on 4000)
PORT=4001
CORS_ORIGINS=http://localhost:4000

# Postgres database for the POC. DBOS keeps its system tables in the same database (schema "dbos").
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/workflows_poc

# GTWY: same org/folder/key as ticket0-b. The POC acts as its own embed user and creates its own agent.
GTWY_ORG_ID=
GTWY_FOLDER_ID=
GTWY_ACCESS_KEY=
GTWY_DB_BASE_URL=https://db.gtwy.ai
GTWY_SERVICE=openai
GTWY_MODEL=gpt-4.1-mini

# Waits, shortened for demos (seconds)
REMIND_AFTER_SEC=120
EXPIRE_AFTER_SEC=600
APPROVAL_TIMEOUT_SEC=1800

# viaSocket Apps API (same org/project as ticket0-b). The POC is its own end user.
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
VIASOCKET_UID=workflows-poc
# 32-byte hex key for encrypting viaSocket script ids at rest
POC_ENCRYPTION_KEY=
